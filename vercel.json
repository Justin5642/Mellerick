{
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "buildCommand": "next build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/google/poll-calendar",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/xero/poll-invoices",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/sites/geocode-missing",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/xero/poll-suppliers",
      "schedule": "40 16 * * *"
    },
    {
      "path": "/api/xero/sync-analytics",
      "schedule": "25 17 * * *"
    },
    {
      "path": "/api/reports/weekly-digest",
      "schedule": "30 19 * * 0"
    }
  ]
}
