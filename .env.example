# Mellerick web app — environment variables.
# Copy to .env.local and fill in. NAMES AND COMMENTS ONLY in this file; never
# commit a real value. On Vercel, set each variable for BOTH Production and
# Preview (a Preview deployment does not inherit Production values).
# Typed accessors: lib/env.ts.

# ---- Required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — any route using it must authorize the caller first.
SUPABASE_SERVICE_ROLE_KEY=
# Required in production: authenticates the Vercel cron routes in vercel.json.
CRON_SECRET=

# ---- Optional integrations (feature-gated; unset = "not connected") ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
BUSINESS_NAME=
BUSINESS_ABN=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# ---- Error monitoring (Sentry) — optional, see HANDOVER §12 -----------------
# Unset = monitoring fully off: the SDK is never initialised, next.config.ts is
# not wrapped, and builds/tests behave exactly as without it.
# The DSN is a public, write-only ingest key (it ships in the browser bundle).
# Used by the browser AND the server. Set it for Production and Preview.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps so stack traces are readable.
# All three must be set or the upload is skipped silently. The auth token is a
# SECRET (Sentry -> Settings -> Auth Tokens, scope project:releases); never
# prefix it NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
