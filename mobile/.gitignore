# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env itself is listed too, not just *.local. It was previously protected only
# by the repo-root .gitignore, which also happens to be what stops EAS uploading
# it as build sources — so the guarantee lived one directory away from the app
# it protects. Kept local so moving or vendoring mobile/ cannot quietly commit
# the Supabase keys.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# release credentials — committing any of these hands over the ability to
# publish or impersonate this app. SHIPPING.md tells you to create the Play
# service-account key at this path, so it must be ignored BEFORE it exists.
play-service-account.json
*.keystore
google-services.json
GoogleService-Info.plist
